{
  "template_id": "bail_regular",
  "display_name": "Regular Bail Application",
  "category": "criminal",
  "description": "Application for regular bail",
  "icon": "scales",
  "plan_access": "free",
  "applicable_courts": {
    "court_levels": [
      "jmfc",
      "cjm",
      "sessions",
      "high_court"
    ],
    "states": [
      "all"
    ]
  },
  "supported_languages": [
    "en",
    "hi",
    "bilingual"
  ],
  "form_schema": {
    "steps": [
      {
        "step": 1,
        "title": "Case Details",
        "fields": [
          {
            "field_id": "fir_number",
            "label": "FIR Number",
            "type": "text",
            "required": true,
            "placeholder": "e.g., 124/2026",
            "inject_into": [
              "cause_title",
              "body_para_1",
              "prayer"
            ]
          },
          {
            "field_id": "fir_date",
            "label": "Date of FIR, or of the complaint if no FIR",
            "type": "date",
            "required": false,
            "inject_into": [
              "body_para_1",
              "prayer"
            ]
          },
          {
            "field_id": "offence_date",
            "label": "Date of the alleged offence (or of the offence of conviction)",
            "type": "date",
            "required": false,
            "inject_into": [
              "ai_prompt"
            ]
          },
          {
            "field_id": "procedure_code",
            "label": "This application is under",
            "type": "dropdown",
            "options": [
              {
                "id": "bnss_and_bsa",
                "label": "BNSS and BSA"
              },
              {
                "id": "crpc_and_evidence_act",
                "label": "CrPC and Evidence Act"
              }
            ],
            "required": false,
            "help": "Matters only for a case that began before 1 July 2024. For an FIR on or after that date, Lawie uses the BNSS.",
            "inject_into": [
              "ai_prompt"
            ]
          },
          {
            "field_id": "police_station",
            "label": "Police Station",
            "type": "text",
            "required": true,
            "inject_into": [
              "body_para_1",
              "prayer"
            ]
          },
          {
            "field_id": "sections_charged",
            "label": "Sections Charged in FIR",
            "type": "multi_select_search",
            "source": "bns_mapping",
            "required": true,
            "auto_convert_old": false,
            "inject_into": [
              "body_para_1",
              "ai_prompt"
            ]
          },
          {
            "field_id": "currently_in_custody",
            "label": "Is the applicant currently in custody?",
            "type": "dropdown",
            "options": [
              {
                "id": "yes_judicial",
                "label": "Yes — Judicial custody"
              },
              {
                "id": "yes_police",
                "label": "Yes — Police custody"
              },
              {
                "id": "no",
                "label": "No — anticipating arrest"
              }
            ],
            "required": true,
            "inject_into": [
              "ai_prompt"
            ]
          },
          {
            "field_id": "custody_since",
            "label": "In custody since (date)",
            "type": "date",
            "required": false,
            "show_if": "currently_in_custody !== no",
            "inject_into": [
              "ai_prompt"
            ]
          },
          {
            "field_id": "earlier_bail_applications",
            "label": "Earlier bail applications in this matter",
            "type": "textarea",
            "required": false,
            "question": "Has any bail application (regular, anticipatory or interim) been made for the applicant in this case before, in any court, including the High Court? If yes, give for each: the court, the date of the order and the result (rejected, dismissed as withdrawn, granted and cancelled, or still pending). If none, write \"None\".",
            "ask_when_empty": true
          },
          {
            "field_id": "antecedents",
            "label": "Criminal antecedents",
            "type": "textarea",
            "required": false,
            "question": "Is any other criminal case (FIR, charge sheet or conviction) pending or past against the applicant? If yes, give each case number, police station or court, sections and its status. If none, write \"None\".",
            "ask_when_empty": true
          },
          {
            "field_id": "arrest_date",
            "label": "Date of arrest",
            "type": "date",
            "required": false,
            "question": "On what date was the applicant arrested? Give the date in the arrest memo, even if custody began on another date.",
            "ask_when_empty": true
          },
          {
            "field_id": "investigation_status",
            "label": "Investigation status",
            "type": "dropdown",
            "options": [
              {
                "id": "under_investigation",
                "label": "Under investigation"
              },
              {
                "id": "charge_sheet_filed",
                "label": "Charge sheet filed"
              },
              {
                "id": "cognizance_taken",
                "label": "Cognizance taken"
              },
              {
                "id": "not_known",
                "label": "Not known"
              }
            ],
            "required": false,
            "question": "What is the stage of the investigation?",
            "ask_when_empty": true
          },
          {
            "field_id": "applicant_sex",
            "label": "Sex of the applicant",
            "type": "dropdown",
            "options": [
              {
                "id": "male",
                "label": "Male"
              },
              {
                "id": "female",
                "label": "Female"
              },
              {
                "id": "transgender",
                "label": "Transgender"
              },
              {
                "id": "not_given",
                "label": "Not given"
              }
            ],
            "required": false,
            "question": "Sex of the applicant.",
            "ask_when_empty": true
          },
          {
            "field_id": "medical_condition",
            "label": "Medical condition of the applicant",
            "type": "textarea",
            "required": false,
            "question": "Does the applicant suffer from any illness, disability or medical condition you want placed before the court? If yes, name it as written in the medical papers. If not, leave it blank.",
            "ask_when_empty": true
          },
          {
            "field_id": "named_in_fir",
            "label": "Whether the applicant is named in the FIR",
            "type": "dropdown",
            "options": [
              {
                "id": "yes",
                "label": "Yes"
              },
              {
                "id": "no",
                "label": "No"
              },
              {
                "id": "not_known",
                "label": "Not known"
              }
            ],
            "required": false,
            "question": "Is the applicant named in the FIR?",
            "ask_when_empty": true
          },
          {
            "field_id": "recovery_status",
            "label": "Recovery or seizure from the applicant",
            "type": "textarea",
            "required": false,
            "question": "Has anything been recovered or seized from the applicant, or at the applicant's instance? If yes, say what. If nothing, write \"None\".",
            "ask_when_empty": true
          },
          {
            "field_id": "cooperated_with_investigation",
            "label": "Whether the applicant has cooperated with the investigation",
            "type": "dropdown",
            "options": [
              {
                "id": "yes",
                "label": "Yes"
              },
              {
                "id": "no",
                "label": "No"
              },
              {
                "id": "not_known",
                "label": "Not known"
              }
            ],
            "required": false,
            "question": "Has the applicant so far joined or cooperated with the investigation (for example, appeared when called or gave a statement)?",
            "ask_when_empty": true
          },
          {
            "field_id": "applicant_occupation",
            "label": "Applicant occupation",
            "type": "text",
            "required": false,
            "question": "What does the applicant do for a living (for example: daily-wage labourer, farmer, driver, shopkeeper)? If nothing, write \"Unemployed\".",
            "ask_when_empty": true
          },
          {
            "field_id": "sole_earning_member",
            "label": "Whether the applicant is the only earning member of the family",
            "type": "dropdown",
            "options": [
              {
                "id": "yes",
                "label": "Yes"
              },
              {
                "id": "no",
                "label": "No"
              },
              {
                "id": "not_known",
                "label": "Not known"
              }
            ],
            "required": false,
            "question": "Is the applicant the only earning member of the family?",
            "ask_when_empty": true
          },
          {
            "field_id": "dependants",
            "label": "Who depends on the applicant",
            "type": "textarea",
            "required": false,
            "question": "Who in the family depends on the applicant's income (for example: aged mother, wife, two minor children)? If not known, leave it blank.",
            "ask_when_empty": true
          },
          {
            "field_id": "local_ties",
            "label": "Family and local ties of the applicant",
            "type": "textarea",
            "required": false,
            "question": "What family or local ties does the applicant have at the address given (for example: lives there with parents, wife and children; owns the house; has lived there since birth)? If not known, leave it blank.",
            "ask_when_empty": true
          },
          {
            "field_id": "s35_notice_status",
            "label": "Notice to appear (Section 35 BNSS / Section 41A CrPC)",
            "type": "dropdown",
            "options": [
              {
                "id": "served",
                "label": "Served"
              },
              {
                "id": "not_served",
                "label": "Not served"
              },
              {
                "id": "not_known",
                "label": "Not known"
              }
            ],
            "required": false,
            "question": "Before the arrest, was a notice of appearance under Section 35(3) of the BNSS served on the applicant?",
            "ask_when_empty": true
          },
          {
            "field_id": "co_accused_bail_court",
            "label": "Court that granted bail to the co-accused",
            "type": "text",
            "required": false,
            "question": "Has any co-accused in this case been granted bail? If yes, which court granted it? If not, leave it blank.",
            "ask_when_empty": true
          },
          {
            "field_id": "co_accused_bail_date",
            "label": "Date of the co-accused's bail order",
            "type": "date",
            "required": false,
            "question": "Date of that bail order.",
            "ask_when_empty": true
          }
        ]
      },
      {
        "step": 2,
        "title": "Court & Parties",
        "fields": [
          {
            "field_id": "state",
            "label": "State",
            "type": "dropdown_search",
            "source": "courts_db.states",
            "required": true,
            "cascades_to": [
              "court_type",
              "court_name"
            ]
          },
          {
            "field_id": "court_type",
            "label": "Court Type",
            "type": "dropdown",
            "source": "courts_db.court_types",
            "filtered_by": [
              "state"
            ],
            "required": true,
            "cascades_to": [
              "court_name"
            ]
          },
          {
            "field_id": "court_name",
            "label": "Court Name",
            "type": "dropdown_search",
            "source": "courts_db.courts",
            "filtered_by": [
              "state",
              "court_type"
            ],
            "required": true,
            "links_to_formatting": true,
            "inject_into": [
              "cause_title"
            ]
          },
          {
            "field_id": "applicant_name",
            "label": "Applicant / Accused Full Name",
            "type": "text",
            "required": true,
            "inject_into": [
              "cause_title",
              "verification",
              "prayer"
            ]
          },
          {
            "field_id": "applicant_relation",
            "label": "Relation to the person named below",
            "type": "dropdown",
            "options": [
              {
                "id": "son_of",
                "label": "Son of (S/o)"
              },
              {
                "id": "daughter_of",
                "label": "Daughter of (D/o)"
              },
              {
                "id": "wife_of",
                "label": "Wife of (W/o)"
              },
              {
                "id": "husband_of",
                "label": "Husband of (H/o)"
              }
            ],
            "required": false,
            "inject_into": [
              "cause_title",
              "verification"
            ]
          },
          {
            "field_id": "father_name",
            "label": "Name of father, mother or spouse",
            "type": "text",
            "required": true,
            "inject_into": [
              "cause_title"
            ]
          },
          {
            "field_id": "applicant_age",
            "label": "Age",
            "type": "number",
            "required": true,
            "inject_into": [
              "cause_title"
            ]
          },
          {
            "field_id": "address",
            "label": "Residential Address",
            "type": "textarea",
            "required": true,
            "inject_into": [
              "cause_title"
            ]
          },
          {
            "field_id": "language",
            "label": "Document Language",
            "type": "dropdown",
            "options_from": "supported_languages",
            "default": "en",
            "required": true
          },
          {
            "field_id": "advocate_enrollment",
            "label": "Bar Council Enrollment No.",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "step": 3,
        "title": "Facts & Grounds",
        "fields": [
          {
            "field_id": "facts_narrative",
            "label": "Brief Facts of the Case (3-5 lines)",
            "type": "textarea",
            "required": true,
            "min_length": 50,
            "max_length": 1500,
            "placeholder": "Describe what happened from the applicant's perspective...",
            "inject_into": [
              "ai_prompt"
            ]
          },
          {
            "field_id": "grounds_for_bail",
            "label": "Grounds for Bail (select all applicable)",
            "type": "checkbox_group",
            "required": true,
            "min_select": 2,
            "options": [
              {
                "id": "false_implication",
                "label": "Falsely implicated due to enmity / mistaken identity"
              },
              {
                "id": "no_flight_risk",
                "label": "Not a flight risk — deep roots in society"
              },
              {
                "id": "no_criminal_antecedent",
                "label": "No prior criminal record / first-time offender"
              },
              {
                "id": "cooperation",
                "label": "Will cooperate with investigation and trial"
              },
              {
                "id": "no_evidence_tampering",
                "label": "No possibility of tampering with evidence"
              },
              {
                "id": "prolonged_custody",
                "label": "Already in prolonged custody"
              },
              {
                "id": "investigation_complete",
                "label": "Investigation is complete / chargesheet filed"
              },
              {
                "id": "medical_grounds",
                "label": "Medical / health grounds"
              },
              {
                "id": "willing_mediation",
                "label": "Willing to participate in mediation / counselling"
              },
              {
                "id": "youth_first_time",
                "label": "Young person, no prior offence"
              }
            ],
            "inject_into": [
              "ai_prompt"
            ]
          },
          {
            "field_id": "additional_context",
            "label": "Anything else the court should know? (optional)",
            "type": "textarea",
            "required": false,
            "max_length": 800,
            "inject_into": [
              "ai_prompt"
            ]
          }
        ]
      }
    ]
  },
  "computed_fields": {
    "court_type_id": {
      "logic": "courts_db.lookup(court_name).court_type"
    },
    "bail_section": {
      "logic": "value_map[court_type_id] || '[Section — verify before filing]'",
      "value_map": {
        "jmfc": "480",
        "cjm": "480",
        "sessions": "483",
        "high_court": "483",
        "high_court_bench": "483"
      },
      "instruction": "This application is made under {governing_provision}. Cite only this one provision as the provision under which bail is sought. Do not cite Section 481 or Section 482."
    },
    "bail_type_label": {
      "logic": "'Regular Bail'"
    },
    "court_designation": {
      "logic": "courts_db.lookup(court_name).designation"
    },
    "court_header": {
      "logic": "courts_db.lookup(court_name).header"
    },
    "court_city": {
      "logic": "courts_db.lookup(court_name).city"
    },
    "case_nomenclature": {
      "logic": "court_rules[court_name].case_nomenclature || '[To be confirmed: case type and number]'"
    }
  },
  "document_structure": {
    "sections": [
      {
        "section_id": "cause_title",
        "type": "template",
        "alignment": "center",
        "template": "{court_header}\n\n{case_nomenclature}\n\nIN THE MATTER OF:\n\n{applicant_name}\n{parent_relation}\nAge: {applicant_age} years\nR/o {address}\n                                              ... {party_label_petitioner}\n\nVersus\n\n{state_respondent}\n                                              ... {party_label_respondent}"
      },
      {
        "section_id": "application_heading",
        "type": "template",
        "alignment": "center",
        "template": "APPLICATION FOR REGULAR BAIL UNDER {GOVERNING_PROVISION}"
      },
      {
        "section_id": "addressing_clause",
        "type": "template",
        "alignment": "left",
        "template": "TO,\nTHE HONOURABLE {court_designation},\n{court_city}\n\nMOST RESPECTFULLY SHOWETH:"
      },
      {
        "section_id": "body",
        "type": "ai_generated",
        "prompt_context": "Generate 7-10 numbered paragraphs for a {bail_type_label} application. Paragraph 1 must mention FIR No. {fir_number} dated {fir_date}, registered at PS {police_station}, under Section(s) {sections_charged}, as written in the FIR. Paragraphs 2-3 should narrate the facts based on: {facts_narrative}. Subsequent paragraphs should establish the grounds for bail: {grounds_for_bail}. Reference Article 21 of Constitution. Use formal legal language. Do NOT generate the prayer clause or verification — those are template-handled.",
        "numbering": "numeric",
        "min_paragraphs": 7,
        "max_paragraphs": 12
      },
      {
        "section_id": "prayer",
        "type": "template",
        "alignment": "left",
        "template": "PRAYER\n\n{prayer_opening}\n\na) Grant {bail_type_label} to the {party_label_petitioner}, {applicant_name}, in connection with FIR No. {fir_number} dated {fir_date}, PS {police_station}, under {governing_provision}, on such terms and conditions as this Hon'ble Court may deem fit;\n\nb) Pass such other orders as this Hon'ble Court may deem fit and proper in the facts and circumstances of the case, in the interest of justice.\n\n{prayer_closing}"
      },
      {
        "section_id": "verification",
        "type": "template",
        "alignment": "left",
        "template": "VERIFICATION\n\n{verification_text}\n\n\n_________________________\n{applicant_name}\n({party_label_petitioner})"
      },
      {
        "section_id": "advocate_block",
        "type": "template",
        "alignment": "right",
        "template": "THROUGH:\n\n_________________________\n{advocate_name}\nAdvocate\nEnrollment No. {enrollment_number}\n\nPlace: {place}\nDate: {current_date}"
      }
    ]
  },
  "related_acts": [
    "BNS",
    "BNSS",
    "Constitution Article 21"
  ],
  "special_prayer_additions": [],
  "filing_checklist": [
    "Certified copy of FIR No. {fir_number}",
    "Vakalatnama duly executed",
    "Surety Bond with ID proof of surety (Aadhaar/PAN)",
    "Address proof of applicant (Aadhaar/Voter ID)",
    "Affidavit of applicant (if required by court)",
    "Verify all BNS/BNSS section numbers before filing",
    "Court fee as per state schedule"
  ],
  "validation_rules": {
    "section_codes_allowed": [
      "BNS",
      "BNSS",
      "BSA"
    ],
    "reject_old_codes": [
      "IPC",
      "CrPC",
      "IEA"
    ],
    "auto_convert_old_to_new": false,
    "mandatory_sections": [
      "cause_title",
      "application_heading",
      "addressing_clause",
      "body",
      "prayer",
      "verification",
      "advocate_block"
    ],
    "fact_alteration_check": true,
    "min_body_paragraphs": 7
  },
  "metadata": {
    "version": "1.0",
    "created_by": "Ajay · CLO",
    "reviewed_at": "2026-04-28",
    "status": "active",
    "next_templates_in_pipeline": [
      "legal_notice_s138",
      "bail_anticipatory",
      "bail_dv_dowry",
      "rent_agreement_residential",
      "consumer_complaint_district"
    ]
  }
}
