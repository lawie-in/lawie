# 1. Scan staged changes for leaked secrets (API keys, tokens, private keys).
#    Fails the commit if anything matches the rules in .gitleaks.toml.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config .gitleaks.toml
else
  echo "⚠️  gitleaks not installed — skipping secret scan."
  echo "   Install via: brew install gitleaks  (or see https://github.com/gitleaks/gitleaks)"
fi

# 2. T-570 secret-shape scan of the staged files under handoff/ and .claude/ (no binary needed).
#    Prints file:line and the shape name only, never a value. Staged files elsewhere and
#    deleted files are ignored. Arjun's ruling (26 Oct 2026): the gitleaks warning above stays;
#    the fail-closed gate is .github/workflows/secret-shape-scan.yml.
yarn -s scan:secrets --staged || exit 1

# 3. Lint + format staged files
./node_modules/.bin/lint-staged
