{
  "agent": "vishal",
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/*.pem)"],
    "ask": ["Bash(git push *)", "Bash(gh pr merge *)", "Bash(gh workflow run *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-secrets-bash.sh"
          }
        ]
      }
    ]
  }
}
