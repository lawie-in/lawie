{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/*.pem)", "Read(//proc/**)"],
    "ask": [],
    "allow": [
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(cd *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(python3 -I *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(aws ssm send-command --instance-ids i-0e11d3dd5716776ff --document-name lawie-prod-ops *)",
      "Bash(aws ssm send-command --instance-ids i-07925b68d6dd907c4 --document-name lawie-prod-ops *)",
      "Bash(aws ssm send-command --profile dev --instance-ids i-07925b68d6dd907c4 --document-name AWS-RunShellScript *)",
      "Bash(aws ssm get-command-invocation --profile dev *)",
      "Bash(aws sts get-caller-identity --profile dev *)",
      "Bash(aws ssm get-command-invocation *)",
      "Bash(aws ec2 start-instances --instance-ids i-07925b68d6dd907c4 *)",
      "Bash(aws ec2 stop-instances --instance-ids i-07925b68d6dd907c4 *)",
      "Bash(aws ec2 wait *)",
      "Bash(aws ec2 describe-instances *)",
      "Bash(curl -s -H \"Authorization: Bearer $CLOUDFLARE_API_TOKEN\" https://api.cloudflare.com/client/v4/*)",
      "ArtifactData",
      "ArtifactComments"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-secrets-bash.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-env-print.sh"
          }
        ]
      }
    ]
  }
}
