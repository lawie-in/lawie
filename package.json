{
  "name": "lawie",
  "version": "1.0.0",
  "private": true,
  "description": "Lawie — Legal Tech Platform (Monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace @lawie/gateway dev\" \"yarn workspace @lawie/auth dev\" \"yarn workspace @lawie/drafting dev\" \"yarn workspace @lawie/billing dev\" \"yarn workspace @lawie/email-worker dev\" \"yarn workspace @lawie/web dev\"",
    "dev:backend": "concurrently \"yarn workspace @lawie/gateway dev\" \"yarn workspace @lawie/auth dev\" \"yarn workspace @lawie/drafting dev\" \"yarn workspace @lawie/billing dev\" \"yarn workspace @lawie/email-worker dev\"",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "marked": "^9.1.6",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "puppeteer": "^24.43.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "pino-pretty": "^13.1.3"
  }
}
