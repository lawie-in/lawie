{
  "name": "@lawie/drafting",
  "version": "1.0.0",
  "description": "Lawie Drafting Service — AI engine, template management",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && cp -r src/config/document-rules dist/config/ && cp -r src/config/court-rules dist/config/ 2>/dev/null; cp -r src/config/courts dist/config/ 2>/dev/null; cp -r src/config/sections dist/config/ 2>/dev/null; cp src/config/bns-*.json dist/config/ 2>/dev/null; true",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.ts' --fix",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:golden:update": "jest --testPathPattern=court-rules-golden --updateSnapshot --forceExit",
    "seed:setting": "ts-node --transpile-only scripts/seed-app-setting.ts",
    "seed:sample-pdfs": "ts-node --transpile-only scripts/seed-sample-pdfs.ts",
    "seed:courts": "ts-node --transpile-only src/scripts/seed-courts.ts",
    "seed:sections": "ts-node --transpile-only src/scripts/seed-sections.ts",
    "seed:templates": "ts-node --transpile-only src/scripts/seed-templates.ts",
    "seed:all": "yarn seed:courts && yarn seed:sections && yarn seed:templates",
    "diff:templates": "ts-node --transpile-only src/scripts/template-diff.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@lawie/shared": "1.0.0",
    "@sentry/node": "^10.50.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "mongoose": "^8.4.1",
    "pino": "^9.1.0",
    "pino-http": "^10.2.0",
    "puppeteer": "^24.43.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
