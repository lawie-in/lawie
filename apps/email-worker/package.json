{
  "name": "@lawie/email-worker",
  "version": "1.0.0",
  "description": "Lawie email worker — drains BullMQ jobs, renders React Email, sends via AWS SES",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts' --fix",
    "replay": "ts-node --transpile-only scripts/replay.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.654.0",
    "@lawie/email-client": "1.0.0",
    "@lawie/shared": "1.0.0",
    "@react-email/components": "^0.0.25",
    "@react-email/render": "^1.0.1",
    "@sentry/node": "^10.50.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.10.1",
    "pino": "^9.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
