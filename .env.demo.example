# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Service Ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
AUTH_PORT=4001
DRAFTING_PORT=4002
BILLING_PORT=4003

# ── Gateway — service discovery ───────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:4001
DRAFTING_SERVICE_URL=http://localhost:4002
BILLING_SERVICE_URL=http://localhost:4003

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/lawie
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=

# ── Redis (managed — Redis Cloud, ap-south-1) ────────────────────────────────
# Gateway + Auth connect to Redis for session management + rate limiting
REDIS_URL=redis://default:YOUR_PASSWORD@redis-18828.crce286.ap-south-1-1.ec2.cloud.redislabs.com:18828

# ── Internal Secret (gateway → service trust) ────────────────────────────────
# Generate: openssl rand -hex 32
# Gateway injects this header; downstream services validate it
INTERNAL_SECRET=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth (auth service) ───────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:4001/google/callback (dev)
#                          https://api.lawie.com/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/google/callback
FRONTEND_URL=http://localhost:3000

# ── Encryption (drafting service — AES-256-GCM) ───────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── AI Provider (drafting service only) ──────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Razorpay (billing service, optional in dev) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@lawie.com

# ── AWS (CI/CD only — never in local dev) ────────────────────────────────────
AWS_REGION=ap-south-1
ECR_REGISTRY=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
