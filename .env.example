# Lawie environment variable names: the single list (handoff/ops/env-variables.md, founder 21 Oct 2026).
# Names and placeholders only. Never put a real value, key, token or secret in this file.
# Local dev: copy to .env.development at the repo root. Each Node service loads .env.<NODE_ENV> from the
# repo root at boot and validates it with zod (apps/<service>/src/config/env.ts); a bad value fails boot.
# Empty secrets below must be generated or obtained before the service that needs them will start.
# Comment format per variable: what it is. Read by. secret|public, required|optional. Prod rule.

# ══ Shared / infra ═══════════════════════════════════════════════════════════════════════════════

# Runtime mode (development|test|staging|production); also picks which .env.<NODE_ENV> file loads. Read by: all services and web. Public, optional (default development). Prod: production.
NODE_ENV=development

# Listen port. Read by: gateway (4000), auth (4001), drafting (4002), billing (4003), email-worker (9100), web (3000). Public, optional. Leave UNSET in this shared file: one value would put every service on the same port, and an empty value fails boot. Compose and pm2 set it per service.
# PORT=

# MongoDB connection string. Read by: auth, drafting, billing (and their seed/backfill scripts). Secret on prod (holds credentials), required.
MONGO_URI=mongodb://localhost:27017/lawie

# Redis connection string. Read by: gateway, auth, drafting (required), email-worker (required), billing (optional: empty means invoice emails are not queued), packages/email-client. Secret on prod (holds credentials), required.
REDIS_URL=redis://localhost:6379

# Gateway-to-service trust header; generate with: openssl rand -hex 32. Read by: gateway, auth, drafting, billing, email-worker. Secret, required (min 16 chars). Prod: unique per environment.
INTERNAL_SECRET=

# Allowed browser origins for CORS, comma-separated. Read by: gateway. Public, optional (default http://localhost:3000). Prod: the prod web origin only.
ALLOWED_ORIGINS=http://localhost:3000

# Web app base URL used for redirects and links. Read by: auth, drafting, billing. Public, optional (default http://localhost:3000). Prod: the prod web origin.
FRONTEND_URL=http://localhost:3000

# Pino log level (trace|debug|info|warn|error|fatal). Read by: gateway, auth, drafting, billing. Public, optional (default info).
LOG_LEVEL=info

# Sentry DSN; empty disables reporting. Read by: gateway, auth, drafting, billing, email-worker, web (server and edge). Secret-ish (do not publish), optional. Sentry only sends when NODE_ENV=production.
SENTRY_DSN=

# Sentry environment tag (T-586); empty falls back to NODE_ENV. Read by: web (server and edge). Public, optional. Prod: production.
SENTRY_ENVIRONMENT=

# Sentry release tag, the commit SHA (T-586); scripts/deploy-local.sh exports it from git rev-parse HEAD, Docker takes it as a web build ARG; empty leaves no release. Read by: web (server and edge at runtime; @sentry/nextjs at build for the browser). Public, optional. Never set by hand.
SENTRY_RELEASE=

# Browser Sentry DSN (T-586); empty means no browser Sentry init. BUILD-TIME: rebuild web after setting. Read by: web (apps/web/instrumentation-client.ts). Public (visible to every browser), optional. Sentry only sends when NODE_ENV=production.
NEXT_PUBLIC_SENTRY_DSN=

# Browser Sentry environment tag (T-586); empty falls back to NODE_ENV. BUILD-TIME: rebuild web after setting. Read by: web (apps/web/instrumentation-client.ts). Public, optional. Prod: production.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# AWS region. Read by: email-worker (SES). Public, optional (default ap-south-1).
AWS_REGION=ap-south-1

# ECR registry host for staging image tags (compose interpolation, not an app variable). Read by: docker-compose.staging.yml. Public, required only for the staging compose; never needed in local dev.
ECR_REGISTRY=

# Lands with T-534. Secrets loader backend (ssm|secretsmanager); absent means read the environment as today. Read by: packages/shared loadSecrets() once T-534 lands. Public, optional. Prod: ssm once the prod box exists.
# SECRETS_BACKEND=

# ══ Gateway ══════════════════════════════════════════════════════════════════════════════════════

# Auth service base URL. Read by: gateway, email-worker (required there, any mode). Public, optional for gateway (default http://localhost:4001).
AUTH_SERVICE_URL=http://localhost:4001

# Drafting service base URL. Read by: gateway, auth (account close/erase, credit bonus). Public, optional (default http://localhost:4002).
DRAFTING_SERVICE_URL=http://localhost:4002

# Billing service base URL. Read by: gateway, auth, email-worker (optional there, T-436: unset means invoice and credit-note emails fail and retry until set). Public, optional (default http://localhost:4003).
BILLING_SERVICE_URL=http://localhost:4003

# JWT signing secret; generate with: openssl rand -hex 64. Read by: gateway, auth. Secret, required (min 32 chars). Prod: unique per environment.
JWT_SECRET=

# ══ Auth ═════════════════════════════════════════════════════════════════════════════════════════

# Refresh-token signing secret; generate with: openssl rand -hex 64. Read by: auth. Secret, required (min 32 chars). Prod: unique per environment, different from JWT_SECRET.
JWT_REFRESH_SECRET=

# Access-token lifetime. Read by: auth. Public, optional (default 15m).
JWT_EXPIRES_IN=15m

# Session lifetime is fixed in code (packages/shared/src/constants/redis.ts): SESSION_TTL_HOURS=12 sliding per refresh, SESSION_ABSOLUTE_DAYS=7 ceiling since sign-in.
# JWT_REFRESH_EXPIRES_IN is no longer read; remove it from any environment that still sets it.

# Google OAuth client id (console.cloud.google.com, APIs & Services, Credentials); set with the secret to enable /google. Read by: auth. Public, optional.
GOOGLE_CLIENT_ID=

# Google OAuth client secret. Read by: auth. Secret, optional (empty disables Google sign-in).
GOOGLE_CLIENT_SECRET=

# Google OAuth redirect URI; must match the console. Read by: auth. Public, optional (default http://localhost:4001/google/callback). Prod: the prod API host's /api/auth/google/callback.
GOOGLE_CALLBACK_URL=http://localhost:4001/google/callback

# Drafting base URL for the referral bonus call (apps/auth/src/services/referral.service.ts). Read by: auth. Public, optional (default http://localhost:4002). Normally the same value as DRAFTING_SERVICE_URL.
DRAFTING_INTERNAL_URL=http://localhost:4002

# T-358 unverified-account sweep: only the exact string 'true' lets it send notices and delete accounts; anything else only logs counts. Read by: auth. Public, optional (default off). Prod: keep off until the founder turns it on per T-403.
UNVERIFIED_SWEEP_ENABLED=false

# T-563 test sign-up bypass switch: only the exact string 'true' turns it on (with the secret below). Read by: auth. Optional (default off). Develop only; must be absent in production (auth refuses to boot).
TEST_SIGNUP_BYPASS=

# T-563 test sign-up bypass secret: 32+ chars with the lts_ prefix; the founder sets it, never in a repo file. Read by: auth. Secret, optional. Develop only; must be absent in production (auth refuses to boot).
TEST_SIGNUP_BYPASS_SECRET=

# ══ Drafting ═════════════════════════════════════════════════════════════════════════════════════

# AES-256-GCM key for case data, exactly 64 hex chars; generate with: openssl rand -hex 32. Read by: drafting. Secret, required. Prod: unique per environment; losing it loses encrypted data.
ENCRYPTION_KEY=

# Anthropic API key (console.anthropic.com, API Keys). Read by: drafting only. Secret, optional in dev, required on staging/prod.
ANTHROPIC_API_KEY=

# Describe-first fallback (on|off) when its AppSetting is missing or not 'on'/'off' (T-283/T-356); the database value always wins. Read by: drafting. Public, optional (default on).
FEATURE_DEFAULT_DESCRIBE_FIRST=on

# Fact-ledger fallback (on|off), same rule as above; stays off until T-187 and T-188 merge. Read by: drafting. Public, optional (default off).
FEATURE_DEFAULT_FACT_LEDGER=off

# Coupon free-grant fallback (T-540): lets a 100% coupon grant top-up Ink with no Razorpay order. Used only when the AppSetting feature.coupon_free_grant is missing; the AppSettings key feature.coupon_free_grant wins, and a database error is always off. Default off; only 'true' turns it on. Keep off until T-553 ships. Read by: billing. Public, optional (default off).
FEATURE_DEFAULT_COUPON_FREE_GRANT=

# Path to a Chrome/Chromium binary for PDF export; empty uses Puppeteer's bundled browser. Read by: drafting. Public, optional.
PUPPETEER_EXECUTABLE_PATH=

# ══ Billing ══════════════════════════════════════════════════════════════════════════════════════

# Razorpay key id (rzp_test_... on develop, rzp_live_... on prod). Read by: billing. Public, required (billing will not boot empty). Prod: live key.
RAZORPAY_KEY_ID=

# Razorpay key secret. Read by: billing. Secret, required. Prod: live secret, never the test one.
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret. Read by: billing. Secret, required. Prod: the secret of the live-mode webhook registered at the prod host; develop uses its own test-mode webhook secret; never the same secret in both (T-526).
RAZORPAY_WEBHOOK_SECRET=

# Legacy single plan id, the fallback when a per-SKU plan id below is unset. Read by: billing. Public, required (billing will not boot empty).
RAZORPAY_PLAN_ID=

# Razorpay plan id for solo monthly (apps/billing/src/config/credit-skus.ts). Read by: billing. Public, optional (falls back to RAZORPAY_PLAN_ID). Prod: live plan id.
RAZORPAY_PLAN_SOLO_MONTHLY=

# Razorpay plan id for solo yearly. Read by: billing. Public, optional (falls back to RAZORPAY_PLAN_ID). Prod: live plan id.
RAZORPAY_PLAN_SOLO_YEARLY=

# Razorpay plan id for pro monthly. Read by: billing. Public, optional (falls back to RAZORPAY_PLAN_ID). Prod: live plan id.
RAZORPAY_PLAN_PRO_MONTHLY=

# Razorpay plan id for pro yearly. Read by: billing. Public, optional (falls back to RAZORPAY_PLAN_ID). Prod: live plan id.
RAZORPAY_PLAN_PRO_YEARLY=

# Live/test key guard (T-527): 'strict' or empty; any other value refuses to boot (T-558). Under NODE_ENV=production with a test (rzp_test_) or unprefixed key: RAZORPAY_ALLOW_TEST_KEYS=true wins whatever this is set to (one warn at boot, no error log, no Sentry); otherwise strict refuses to boot, and empty logs an error and sends a Sentry event at boot, then continues. A live (rzp_live_) key outside production always refuses to boot. Read by: billing. Public, optional. Prod: set to strict (T-533).
RAZORPAY_KEY_GUARD=

# Lets NODE_ENV=production run with test keys (T-527): 'true' or empty; any other value refuses to boot (T-558). 'true' wins whatever RAZORPAY_KEY_GUARD is (one warn at boot, no error log, no Sentry). Demo only (docker-compose.demo.yml sets it). Read by: billing. Public, optional (empty has no effect). Prod: must be ABSENT.
RAZORPAY_ALLOW_TEST_KEYS=

# T-436 invoice and credit-note emails: 'true' | 'false' | '' (anything else fails boot); only 'true' queues them. Read by: billing. Public, optional (default false). Keep false until the email-worker runs with BILLING_SERVICE_URL.
INVOICE_EMAIL_ENABLED=false

# GST seller GSTIN for tax invoices (T-436). Read by: billing. Public, optional for boot; invoices are not issued while any GST_* seller field is empty.
GST_GSTIN=

# GST seller legal name. Read by: billing. Public, optional for boot (invoices wait until set).
GST_LEGAL_NAME=

# GST seller trade name. Read by: billing. Public, optional for boot (invoices wait until set).
GST_TRADE_NAME=

# Registered seller address; also the supplier address in the password-reset email footer (T-221). Read by: billing, email-worker. Public, optional for boot (invoices wait; reset emails are held while unset).
GST_ADDRESS=

# GST state code of the seller (two digits). Read by: billing. Public, optional for boot (invoices wait until set).
GST_STATE_CODE=

# GST registration effective date (YYYY-MM-DD, IST midnight, or ISO date-time); payments before it get no invoice. Read by: billing. Public, optional for boot (invoices wait until set).
GST_EFFECTIVE_FROM=

# Path to a scanned signature image for the invoice PDF. Read by: billing. Public, optional.
GST_SIGNATURE_PATH=

# ══ Email worker (SCRUM-77) ══════════════════════════════════════════════════════════════════════
# Also reads REDIS_URL, INTERNAL_SECRET, AUTH_SERVICE_URL, BILLING_SERVICE_URL, AWS_REGION, GST_ADDRESS and SENTRY_DSN above.

# Send provider (ses|smtp|dry-run). Read by: email-worker. Public, optional (default ses).
EMAIL_PROVIDER=ses

# 'true' renders but never sends; 'false' or '' sends for real. Read by: email-worker. Public, optional (code default false). Keep true while developing.
EMAIL_DRY_RUN=true

# BullMQ key namespace. Read by: email-worker, packages/email-client (every enqueuing service). Public, optional (default lawie). Must match between the worker and the enqueuers.
EMAIL_QUEUE_PREFIX=lawie

# Concurrent jobs per queue. Read by: email-worker. Public, optional (default 5).
EMAIL_WORKER_CONCURRENCY=5

# Sender display name. Read by: email-worker. Public, optional (default Lawie).
EMAIL_FROM_NAME=Lawie

# Sender address. Read by: email-worker. Public, optional (default noreply@lawie.in).
EMAIL_FROM_ADDRESS=noreply@lawie.in

# Reply-to address. Read by: email-worker. Public, optional (default contact@lawie.in).
EMAIL_REPLY_TO=contact@lawie.in

# Founder notification address. Read by: email-worker (apps/email-worker/src/config/env.ts). Public, optional (default founder@lawie.in).
EMAIL_FOUNDER=founder@lawie.in

# Reroute every send to one test inbox. Read by: email-worker. Public, optional. Leave commented unless used: an empty value fails boot (must be an email address). Prod: absent.
# EMAIL_DEV_REDIRECT_TO=

# SES access key id. Read by: email-worker. Secret, required when EMAIL_PROVIDER=ses and EMAIL_DRY_RUN is not true.
AWS_SES_ACCESS_KEY_ID=

# SES secret access key. Read by: email-worker. Secret, required when EMAIL_PROVIDER=ses and EMAIL_DRY_RUN is not true.
AWS_SES_SECRET_ACCESS_KEY=

# SMTP host. Read by: email-worker. Public, required when EMAIL_PROVIDER=smtp and EMAIL_DRY_RUN is not true.
SMTP_HOST=

# SMTP port. Read by: email-worker. Public, optional (default 587; an empty value fails boot).
SMTP_PORT=587

# SMTP user. Read by: email-worker. Secret-ish, required when EMAIL_PROVIDER=smtp and EMAIL_DRY_RUN is not true.
SMTP_USER=

# SMTP password. Read by: email-worker. Secret, required when EMAIL_PROVIDER=smtp and EMAIL_DRY_RUN is not true.
SMTP_PASS=

# ══ Web (Next.js) ════════════════════════════════════════════════════════════════════════════════
# BUILD-TIME: every NEXT_PUBLIC_* value is inlined by `next build`. Setting or changing one means rebuilding
# web, not restarting it. In Docker each one must also be an ARG in apps/web/Dockerfile and a build.args
# entry in the compose file (docker compose ... up -d --build web). Values are visible to every browser.

# Gateway URL the browser calls. Read by: web. Public, BUILD-TIME, optional (default http://localhost:4000). Prod: the prod API origin; rebuild web after setting.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Grievance Officer name. BUILD-TIME: rebuild web after setting. Unset shows "For complaints, write to contact@lawie.in." (AJ-517-M21). Read by: web. Public, optional. Demo: set it in .env.demo and start the build with exactly `docker compose --env-file .env.demo -f docker-compose.demo.yml up -d --build web`; compose build.args don't read env_file.
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=

# Set by Next.js itself (nodejs|edge) for instrumentation.ts; never set by hand. Read by: web. Public.
# NEXT_RUNTIME=

# Bind address for the standalone server; docker-compose.demo.yml sets 0.0.0.0. Read by: web (Next standalone server). Public, optional.
# HOSTNAME=

# ══ CI only (GitHub Actions); never set in an env file ═══════════════════════════════════════════

# Set by CI runners; skips husky install and makes Sentry upload logging verbose. Read by: .husky/install.mjs, apps/web/next.config.mjs. Public, optional.
# CI=

# Set to 0 to skip husky install (the Dockerfiles do). Read by: .husky/install.mjs. Public, optional.
# HUSKY=

# Real Redis for Redis-backed tests. Read by: tests in auth and email-worker; set in .github/workflows/ci.yml. Public, optional.
# REDIS_TEST_URL=

# mongodb-memory-server binary version. Read by: mongodb-memory-server in tests; set in ci.yml. Public, optional.
# MONGOMS_VERSION=

# mongodb-memory-server binary cache dir. Read by: mongodb-memory-server in tests; set in ci.yml. Public, optional.
# MONGOMS_DOWNLOAD_DIR=

# Codecov upload token. Read by: ci.yml (GitHub Actions secret). Secret.
# CODECOV_TOKEN=

# Golden-set --real Anthropic key. Read by: scripts/golden-set/run.ts via golden-set.yml (GitHub Actions secret). Secret, required for --real only.
# GOLDEN_SET_ANTHROPIC_API_KEY=

# Golden-set --real MongoDB URI. Read by: scripts/golden-set/run.ts via golden-set.yml (GitHub Actions secret). Secret, required for --real only.
# GOLDEN_SET_MONGODB_URI=

# Golden-set fixture encryption key; a random per-run key is used when unset. Read by: scripts/golden-set/run.ts. Secret, optional.
# GOLDEN_SET_ENCRYPTION_KEY=
