# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Service Ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
AUTH_PORT=4001
DRAFTING_PORT=4002
BILLING_PORT=4003

# ── Gateway — service discovery ───────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:4001
DRAFTING_SERVICE_URL=http://localhost:4002
BILLING_SERVICE_URL=http://localhost:4003

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/lawie
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev: docker-compose.yml runs Redis at redis://redis:6379 (set automatically)
# Production: Redis Cloud (ap-south-1) — set via AWS Secrets Manager
REDIS_URL=redis://localhost:6379

# ── Internal Secret (gateway → service trust) ────────────────────────────────
# Generate: openssl rand -hex 32
# Gateway injects this header; downstream services validate it
INTERNAL_SECRET=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth (auth service) ───────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:4001/google/callback (dev)
#                          https://api.lawie.com/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/google/callback
FRONTEND_URL=http://localhost:3000

# ── Encryption (drafting service — AES-256-GCM) ───────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── AI Provider (drafting service only) ──────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Razorpay (billing service, optional in dev) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (SCRUM-77) ─────────────────────────────────────────────────────────
# email-worker drains BullMQ jobs, renders React Email, sends via AWS SES.
# Stage A defaults to dry-run (no SES calls). Stage C wires real SES creds
# via AWS Secrets Manager once IAM + DNS are provisioned.
EMAIL_PROVIDER=ses                        # ses | smtp | dry-run
EMAIL_DRY_RUN=true                        # while developing — flip to false for live send
EMAIL_QUEUE_PREFIX=lawie                  # BullMQ key namespace
EMAIL_WORKER_CONCURRENCY=5                # per-queue concurrent jobs
EMAIL_FROM_NAME=Lawie
EMAIL_FROM_ADDRESS=noreply@lawie.in
EMAIL_REPLY_TO=contact@lawie.in
EMAIL_FOUNDER=founder@lawie.in
EMAIL_DEV_REDIRECT_TO=                    # optional — reroute all sends to one test inbox
AWS_SES_ACCESS_KEY_ID=                    # required once EMAIL_DRY_RUN=false
AWS_SES_SECRET_ACCESS_KEY=                # required once EMAIL_DRY_RUN=false

# ── AWS (CI/CD only — never in local dev) ────────────────────────────────────
AWS_REGION=ap-south-1
ECR_REGISTRY=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
