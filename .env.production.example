# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Service Ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
AUTH_PORT=4001
DRAFTING_PORT=4002
BILLING_PORT=4003

# ── Gateway — service discovery (internal ECS DNS or Docker network names) ────
AUTH_SERVICE_URL=http://auth:4001
DRAFTING_SERVICE_URL=http://drafting:4002
BILLING_SERVICE_URL=http://billing:4003

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Injected from AWS Secrets Manager: /lawie/prod/MONGO_URI
MONGO_URI=mongodb+srv://lawie_user:CHANGE_ME@lawie-prod.xxx.mongodb.net/lawie?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Injected from AWS Secrets Manager: /lawie/prod/JWT_SECRET
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME
# Injected from AWS Secrets Manager: /lawie/prod/JWT_REFRESH_SECRET
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (drafting service — AES-256-GCM) ───────────────────────────────
# Injected from AWS Secrets Manager: /lawie/prod/ENCRYPTION_KEY
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.lawie.com

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://lawie.com,https://www.lawie.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=warn

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
ECR_REGISTRY=CHANGE_ME.dkr.ecr.ap-south-1.amazonaws.com

# ── Razorpay (billing service) ────────────────────────────────────────────────
# Injected from AWS Secrets Manager: /lawie/prod/RAZORPAY_*
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
# Injected from AWS Secrets Manager: /lawie/prod/SMTP_PASS
SMTP_PASS=CHANGE_ME
EMAIL_FROM=noreply@lawie.com

# ── Sentry ────────────────────────────────────────────────────────────────────
# Injected from AWS Secrets Manager: /lawie/prod/SENTRY_DSN
SENTRY_DSN=CHANGE_ME
NEXT_PUBLIC_SENTRY_DSN=CHANGE_ME
